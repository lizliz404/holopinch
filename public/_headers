/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=()

# Hashed Vite assets only. Keep immutable ONLY on real fingerprinted files.
# Do not SPA-fallback HTML onto these paths (see docs/INCIDENT-asset-cache.md).
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.svg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.jpg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.webm
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.mp4
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/media/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# Self-hosted MediaPipe runtime: versioned by our own deploys, safe to cache long.
/mediapipe/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff
